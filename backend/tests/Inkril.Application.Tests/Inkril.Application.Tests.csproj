<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    FrameworkReference grants access to ASP.NET Core types (IUserStore, UserManager, etc.)
    without pulling in the full web SDK. Required for mocking Identity components.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!--
      MockQueryable.Moq wraps a List<T> into an IQueryable<T> that supports
      EF Core async extension methods (ToListAsync, SumAsync, CountAsync on IQueryable).
      Needed for handlers that call uow.Repo.Query().Where(...).SumAsync(...).
    -->
    <PackageReference Include="MockQueryable.Moq" Version="7.0.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inkril.Application\Inkril.Application.csproj" />
    <ProjectReference Include="..\..\src\Inkril.Domain\Inkril.Domain.csproj" />
  </ItemGroup>

</Project>
