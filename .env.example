# ============================================================
# Inkril — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=220088
POSTGRES_USER=inkril
POSTGRES_PASSWORD=change_me_in_production
DB_HOST=postgres
DB_PORT=5432
CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# ── JWT ───────────────────────────────────────────────────
JWT_KEY=your-super-secret-key-min-32-characters-long
JWT_ISSUER=inkril-api
JWT_AUDIENCE=inkril-clients
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=inkril
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=/

# ── SMTP (Email) ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@inkril.app
SMTP_PASSWORD=change_me_in_production
SMTP_USE_SSL=true
SMTP_FROM_NAME=Inkril
SMTP_FROM_EMAIL=noreply@inkril.app

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# ── API ──────────────────────────────────────────────────
API_PORT=8080
WORKER_PORT=8081
ASPNETCORE_ENVIRONMENT=Development

# ── Flutter (set via --dart-define) ──────────────────────
# flutter run --dart-define=API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
