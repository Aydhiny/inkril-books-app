# ============================================================
# Inkril — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=220088
POSTGRES_USER=inkril
POSTGRES_PASSWORD=change_me_in_production
DB_HOST=postgres
DB_PORT=5432
CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# ── JWT ───────────────────────────────────────────────────
JWT_KEY=your-super-secret-key-min-32-characters-long
JWT_ISSUER=inkril-api
JWT_AUDIENCE=inkril-clients
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=inkril
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=/

# ── SMTP (Email) ─────────────────────────────────────────
# For Gmail: use smtp.gmail.com + an App Password (not your real password).
# Google Account → Security → 2-Step Verification → App passwords → generate.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_USE_SSL=true
SMTP_FROM_NAME=Inkril
SMTP_FROM_EMAIL=your@gmail.com

# ── Stripe ────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys (use test keys for dev).
# WebhookSecret: run `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
# and copy the whsec_... value it prints, OR create one in the Dashboard.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# ── API ──────────────────────────────────────────────────
API_PORT=8080
WORKER_PORT=8081
ASPNETCORE_ENVIRONMENT=Development

# ── Flutter (set via --dart-define) ──────────────────────
# flutter run --dart-define=API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
